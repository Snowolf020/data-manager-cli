generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

datasource sqliteDB {
  provider = "sqlite"
  url      = env("DATABASE_URL_SQLITE")
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
  name     String?
}

model Data {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jsonData  Json
  createdAt DateTime @default(now())
}
